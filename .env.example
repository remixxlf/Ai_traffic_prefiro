# Banco de Dados Multi-tenant
DATABASE_URL="file:./dev.db"

# Motor de Inteligência Artificial (Groq API - Llama 3.3 70B)
# Obtenha sua chave oficial em: https://console.groq.com/keys
GROQ_API_KEY=

# Ambiente de Execução
ENVIRONMENT=production
ACTIVE_META_ADAPTER=production
ACTIVE_PREFIRO_ADAPTER=production

# Configurações Oficiais da Meta Ads Graph API (Meta for Developers)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback
META_API_VERSION=v20.0

# Configurações Oficiais da Prefiro Delivery
PREFIRO_DELIVERY_BASE_URL=https://prefirodelivery.com
