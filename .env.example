# ==============================================================================
# PLATAFORMA DE GESTÃO DE TRÁFEGO COM IA PARA RESTAURANTES E DELIVERY
# ARQUIVO DE CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (PRISMA MULTI-TENANT)
# ------------------------------------------------------------------------------
# Para desenvolvimento local (SQLite):
DATABASE_URL="file:./dev.db"

# Para ambiente de produção (PostgreSQL):
# DATABASE_URL="postgresql://usuario:senha@seu-host-postgres.com:5432/gestao_trafego_ia?schema=public&sslmode=prefer"

# ------------------------------------------------------------------------------
# 2. MOTOR DE INTELIGÊNCIA ARTIFICIAL (GROQ API - LLAMA 3.3 70B & 3.1 8B)
# ------------------------------------------------------------------------------
# Chave oficial da API da Groq para inferência LLM ultrarrápida.
# Obtenha gratuitamente ou gerencie suas chaves em: https://console.groq.com/keys
GROQ_API_KEY="gsk_sua_chave_groq_aqui"

# ------------------------------------------------------------------------------
# 3. MODO DE OPERAÇÃO DOS ADAPTADORES (SANDBOX vs PRODUCTION)
# ------------------------------------------------------------------------------
# ENVIRONMENT: Define o perfil geral do sistema ('sandbox' ou 'production')
ENVIRONMENT="sandbox"

# ACTIVE_META_ADAPTER:
# - 'sandbox': Usa o simulador local de Meta Ads (mock completo com dados realistas sem cobrança e sem precisar de conta Meta)
# - 'production': Faz chamadas reais à Meta Graph API v20.0 usando as credenciais abaixo
ACTIVE_META_ADAPTER="sandbox"

# ACTIVE_PREFIRO_ADAPTER:
# - 'sandbox': Usa dados simulados da Prefiro Delivery (produtos, vendas, pedidos e clientes)
# - 'production': Comunica-se via REST com os endpoints oficiais da Prefiro Delivery
ACTIVE_PREFIRO_ADAPTER="sandbox"

# ------------------------------------------------------------------------------
# 4. INTEGRAÇÃO OFICIAL META MARKETING API (GRAPH API v20.0)
# Obtenha no Meta for Developers: https://developers.facebook.com/apps
# ------------------------------------------------------------------------------
# ID do Aplicativo registrado no Meta for Developers
META_APP_ID="seu_meta_app_id"

# Chave Secreta do Aplicativo Meta (App Secret)
META_APP_SECRET="seu_meta_app_secret"

# URI de Redirecionamento OAuth 2.0 (deve estar cadastrada no painel da Meta em Facebook Login > Settings)
META_REDIRECT_URI="http://localhost:3000/api/auth/meta/callback"

# Versão oficial da Graph API
META_API_VERSION="v20.0"

# ------------------------------------------------------------------------------
# 5. INTEGRAÇÃO PREFIRO DELIVERY
# ------------------------------------------------------------------------------
# URL base da plataforma Prefiro Delivery
PREFIRO_DELIVERY_BASE_URL="https://prefirodelivery.com"
